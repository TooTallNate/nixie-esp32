(version 1)

# Rules are evaluated in order; later rules take precedence over earlier ones,
# so the most specific rule (the U4 fanout exception) comes last.

(rule "HV to everything else"
	(condition "A.NetClass == 'HV' && B.NetClass != 'HV'")
	(constraint clearance (min 1.5mm)))

(rule "HV to HV"
	(condition "A.NetClass == 'HV' && B.NetClass == 'HV'")
	(constraint clearance (min 1.0mm)))

# The SN74141 DIP pads have approximately 0.9mm copper spacing. Relax the
# clearance only when both items are inside the same decoder courtyard.
(rule "HV spacing inside SN74141 packages"
	(condition "((A.intersectsCourtyard('U4') && B.intersectsCourtyard('U4')) || (A.intersectsCourtyard('U5') && B.intersectsCourtyard('U5')) || (A.intersectsCourtyard('U6') && B.intersectsCourtyard('U6'))) && (A.NetClass == 'HV' || B.NetClass == 'HV')")
	(constraint clearance (min 0.8mm)))
